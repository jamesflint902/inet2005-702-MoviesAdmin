@model MoviesAdmin.Models.AudienceRating

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-white">Rating Details</h1>


<div>
    @* <h4>AudienceRating</h4> *@


    <hr class="border-light" />

    <div class="p-3 bg-dark text-white rounded">

    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Rating)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rating)
        </dd>
    </dl>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Movies)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Movies)
        </dd>
    </dl>

</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger me-3 border-white border-1">Edit</a>
    <a asp-action="Index" class="text-white fw-bold">Back to Ratings</a>
</div>
</div>
