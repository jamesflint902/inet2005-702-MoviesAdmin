@model MoviesAdmin.Models.AudienceRating

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-white">Create Rating</h1>

@* <h4>AudienceRating</h4> *@

<hr class="border-light" />

<div class="p-3 bg-dark text-white rounded">
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Rating" class="control-label"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            @* <div class="mb-3">
                <label asp-for="Movies" class="control-label"></label>
                <input asp-for="Movies" class="form-control" />
                <span asp-validation-for="Movies" class="text-danger"></span>
            </div> *@

            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-danger me-3 border-white border-1" />
            </div>



        </form>
    </div>
</div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="text-white fw-bold">Back to Rating</a>
</div>
