@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}


@* @if (user.IsInRole("admin"){
    
    <p>
        <a asp-action="Create"
} *@

<h1 class="text-white">Movies</h1>

<hr class="border-light" />

<div class="p-3 bg-dark text-white rounded">
   
<p>
    <a asp-action="Create" class="btn btn-success border-white border-1">Create New</a>
</p> 


<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>
                    <!-- Image of Trail -->
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AudienceRating)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Description)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>

            <td>
               <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail" />
            </td>


            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @item.Genre.Title
            </td>
            <td>
                 @item.AudienceRating.Rating
            </td> 
            @* <td>
                @Html.DisplayFor(model => item.Description)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.Runtime)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                 <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-danger me-3 border-white border-1">Edit</a> 
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-danger me-3 border-white border-1">Details</a>
                 <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger me-3 border-white border-1">Delete</a> 
            </td>
        </tr>
}
    </tbody>
</table>
