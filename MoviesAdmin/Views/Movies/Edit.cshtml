@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-white">Edit</h1>

@* <h4 class="text-white">Movie</h4> *@

<hr class="border-light" />


<div class="p-3 bg-dark text-white rounded">
<div class="row">

    <div class="col-md-12">

      <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

                <div class="d-flex align-items-start gap-4">

                    <!-- Poster -->
                    <div>
                        <img src="@Model.ImageUrl"
                             alt="@Model.Title"
                             width="200"
                             class="rounded shadow" />
                    </div>


            @*Movie info*@ 

            <div class="flex-grow-1">

            <div class="mb-3">
                <label asp-for="Title" class="form-label text-white fw-bold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            
                @* <div class="mb-3">
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="w-25" />
                </div> *@


            @* <div class="mb-3">
                <label asp-for="Genre" class="form-label text-white fw-bold"></label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rating" class="form-label text-white fw-bold"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span> 
            </div>*@


                @*GENRE ID*@
                <div class="mb-3">
                    <label asp-for="GenreId" class="control-label"></label>
                    <select asp-for="GenreId" class="form-control" asp-items="ViewBag.GenreId">
                        @* <option value="">-- Select Genre --</option> *@
                    </select>
                    <span asp-validation-for="GenreId" class="text-danger"></span>
                </div>

            
                @*Audience Rating*@
                <div class="mb-3">
                    <label asp-for="AudienceRatingId" class="control-label"> Audience Rating </label>
                    <select asp-for="AudienceRatingId" class="form-control" asp-items="ViewBag.AudienceRatingId">
                        @* <option value="">-- Select Rating --</option> *@
                    </select>
                    <span asp-validation-for="AudienceRatingId" class="text-danger"></span>
                </div>


            <div class="mb-3">
                <label asp-for="Description" class="form-label text-white fw-bold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5">
                     </textarea>
                @* <input asp-for="Description" class="form-control" /> *@
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                    <label asp-for="Runtime" class="form-label text-white fw-bold"></label> (min)
                <input asp-for="Runtime" class="form-control" />
                <span asp-validation-for="Runtime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ReleaseDate" class="form-label text-white fw-bold"></label>
                <input asp-for="ReleaseDate" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>

                    </div>

                </div> 
            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-danger me-3 border-white border-1" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index"class="text-white fw-bold">Back to Movies</a>
</div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
