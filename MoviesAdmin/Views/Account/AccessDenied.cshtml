@* Displayed when a user attempts to access a page restricted to another role *@

@{
    ViewData["Title"] = "Access Denied";
}

<h1 class="text-white">Access Denied</h1>

<hr class="border-light" />

<div class="p-4 bg-dark text-white rounded">

    <h3 class="text-danger">
        You don't have permission to access this page.
    </h3>

    @if (User.IsInRole("Admin"))
    {
        <p>
            This area is available only to movie critics.
        </p>
    }

    @if (User.IsInRole("Critic"))
    {
        <p>
            This area is available only to administrators.
        </p>
    }

    <div class="mt-3">

        <a asp-controller="Movies" asp-action="Index" class="text-white fw-bold me-3"> Back to Movies </a>

        @if (User.IsInRole("Critic"))
        {

            <a asp-controller="Reviews" asp-action="Index" class="text-white fw-bold"> Back to Reviews </a>
        }

    </div>

</div>
