@{
    ViewData["Title"] = "User Profile";
}

<h1 class="text-white">User Profile</h1>

<hr class="border-light" />

<div class="p-4 bg-dark text-white rounded">

    <div class="row align-items-center">

        <div class="col-md-3 text-center">

            <img src="@User.FindFirst(c => c.Type == "picture")?.Value"
                 alt="Profile Picture"
                 class="img-fluid rounded-circle border border-light"
                 style="max-width:200px;" />

        </div>

        <div class="col-md-9">

            <h2>@User.Identity?.Name</h2>

            <p>
                <strong>Email:</strong>
                @User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value
            </p>

            <p>
                <strong>Role:</strong>

                @if (User.IsInRole("Admin"))
                {
                    <span class="badge bg-danger">Admin</span>
                }
                else if (User.IsInRole("Critic"))
                {
                    <span class="badge bg-success">Critic</span>
                }
            </p>

            <p>
                <strong>User ID:</strong>
                @User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            </p>

        </div>

    </div>

</div>